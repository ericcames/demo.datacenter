data "aws_ami" "ubuntu" {
  most_recent = true
  owners = [
    "099720109477",
    "self"
  ]
  filter {
    name   = "name"
    values = ["ubuntu/images/hvm-ssd-gp3/ubuntu-noble-24.04-amd64-server-*"]
  }
}

